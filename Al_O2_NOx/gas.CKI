!  -------------------- Al2  mechanism --------------------

!  --------------------------------------------------------

Al2O3 = Al2O2 + O			3.0E15	0. 	97649.99 

Al2O3 = AlO2 + AlO			3.0E15 	0. 	126999.89

! AlO + AlO2 = Al2O3			2.770E+07	1.611E-01	1.368E+04	!!!HPL:10^12atm, Masatoshi Saba, et al. CNF, 2021.

Al2O2 = AlO + AlO			1.0E15 	0. 	117939.78	!!!J. Glorian, et al. CNF, 2016.

Al2O2 = Al + AlO2			1.0E15 	0. 	148899.82	!!!J. Glorian, et al. CNF, 2016.

Al2O2 = Al2O + O			1.0E15 	0.	104249.94	!!!J. Glorian, et al. CNF, 2016.

Al2O = AlO + Al				1.0E15 	0.	133199.94	!!!J. Glorian, et al. CNF, 2016. !!!!!!!alternative

Al2O3 => Al2O3L				1.0E14 	0.	0.		!!!J. Glorian, et al. CNF, 2016.

